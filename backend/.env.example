# Copy to .env only if a private file does not already exist. Never commit secrets.
# Supabase Dashboard > Connect: Direct on IPv6, Session pooler on IPv4 (port 5432).
# Use the exact dashboard host and username; percent-encode URI passwords.
# Application login: dedicated read-only role, provisioned per docs/SUPABASE_SETUP.md.
DATABASE_URL=postgresql+psycopg://<APP_USER>:<URL_ENCODED_PASSWORD>@<EXACT_DASHBOARD_HOST>:5432/postgres?sslmode=verify-full

# Schema-owner connection for migrations/imports, targeting the same database.
MIGRATION_DATABASE_URL=postgresql+psycopg://<MIGRATION_USER>:<URL_ENCODED_PASSWORD>@<EXACT_DASHBOARD_HOST>:5432/postgres?sslmode=verify-full

# Download the CA certificate from your project. Use forward slashes on Windows.
DATABASE_SSL_ROOT_CERT=<ABSOLUTE_PATH_TO_DOWNLOADED_CERTIFICATE>
# MIGRATION_DATABASE_SSL_ROOT_CERT=<PATH_IF_MIGRATION_CONNECTION_USES_ANOTHER_CA>

# Optional: enable only after reviewing a real-data model release.
# MODEL_ARTIFACT_DIR=<ABSOLUTE_PATH_TO_REVIEWED_RELEASE_DIRECTORY>
# MODEL_MANIFEST_SHA256=<EXACT_MANIFEST_SHA256_FROM_REVIEWED_EXPORT>

# Finalized hybrid domain detector: install the sibling ml package (see README).
# Editable installs resolve ../ml resources automatically. Wheel deployments
# must point this at a trusted artifact directory containing models/ and data/.
# BETGUARD_ML_ROOT=<ABSOLUTE_PATH_TO_ML_ARTIFACT_DIRECTORY>
